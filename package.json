    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "lucide": "1.55.0"
  }
}
